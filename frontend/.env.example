# ============================================================================
# TicketU Front-end
# ============================================================================
#
# URL pública del API Gateway.
#
# Esta dirección es utilizada por el navegador, por lo que debe ser accesible
# desde fuera de los contenedores Docker.
#
# Desarrollo local:
#   http://localhost:8080
#
# Ejemplo en un servidor:
#   http://192.168.1.50:8080
#
# Ejemplo con dominio:
#   https://api.ticketu.cl
#
# No utilizar aquí nombres DNS internos de Docker como:
#   http://gateway:8080
# ============================================================================

NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080

# ----------------------------------------------------------------------------
# Módulo Pagos (Grupo 4)
# ----------------------------------------------------------------------------
# Llave PUBLICABLE de Stripe en modo prueba (pk_test_...). Es pública: puede ir en el navegador.
# Sin ella, la página /pagos muestra un aviso y no permite pagar con tarjeta.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# (Opcional) Página de inicio de sesión a la que /pagos redirige si la sesión no es válida.
# Vacío = /auth de este mismo front. Se agrega ?volver=<url> para regresar al checkout.
NEXT_PUBLIC_LOGIN_URL=
