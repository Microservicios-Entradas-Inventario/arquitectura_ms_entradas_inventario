  tipo_entrada string [not null, note: 'ENUM: PAGADA, GRATUITA']
  precio_unitario int [not null, note: 'min=0']
  stock_inicial int [not null, note: 'min=0']
  stock_actual int [not null, note: 'min=0']
  cantidad_entrada_reservada int [not null, note: 'min=0']
  cantidad_entrada_comprada int [not null, note: 'min=0']
  maximo_ticket int [not null, note: 'min=1']
  estado_gestion string [not null, note: 'ENUM: BORRADOR, PUBLICADO, FINALIZADO, CANCELADO']
  fecha_actualizacion date [not null]

  indexes {
    id_evento [name: 'pk_inventario_id_evento', unique]
