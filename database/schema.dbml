  }
}

Table reserva_entrada {
  _id objectId [not null, note: 'Clave interna MongoDB']
  id_reserva string [pk, not null, note: 'PK negocio (unique index)']
  hold_id string [null]
  id_evento string [not null, ref: > inventario_evento.id_evento, note: 'FK interna -> inventario_evento.id_evento']
  id_usuario string [not null, note: 'Ref externa -> Auth (Usuario)']
  nombre_usuario string [not null]
  rut_usuario string [null]
  correo_usuario string [null]
  rol_usuario string [not null, note: 'ENUM: USUARIO, STAFF, ORGANIZADOR, usuario, staff, organizador']
  cantidad_entrada int [not null, note: 'min=1']
  id_promocion string [null, note: 'Ref externa -> Promociones']
  nombre_codigo string [null]
  porcentaje_descuento int [not null, note: 'min=0; max=100']
  monto_total int [not null, note: 'min=0']
  id_pago string [null, note: 'Ref externa -> Pagos']
  estado_reserva string [not null, note: 'ENUM: RESERVADO, CONSOLIDADO, EXPIRADO, CANCELADO']
  fecha_cancelacion date [null]
  fecha_creacion date [not null]
  fecha_expiracion date [null]

  indexes {
    id_reserva [name: 'pk_reserva_id_reserva', unique]
    id_evento [name: 'fk_reserva_inventario_evento']
    (id_usuario, id_evento) [name: 'idx_reserva_usuario_evento']
    (estado_reserva, fecha_expiracion) [name: 'idx_reserva_estado_expiracion']
    id_pago [name: 'idx_reserva_id_pago']
  }
}

Table entrada {
  _id objectId [not null, note: 'Clave interna MongoDB']
  id_entrada string [pk, not null, note: 'PK negocio (unique index); Ref externa -> Check-in (QR)']
  id_reserva string [not null, ref: > reserva_entrada.id_reserva, note: 'FK interna -> reserva_entrada.id_reserva']
  id_evento string [not null, ref: > inventario_evento.id_evento, note: 'FK interna -> inventario_evento.id_evento']
