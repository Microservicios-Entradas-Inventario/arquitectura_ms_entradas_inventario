# ==============================================================================
# .gitignore — TicketU (Entradas, Inventario y Persistencia)
# ==============================================================================

# Entornos Virtuales de Python
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Bytecode y Caché de Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Pruebas y Cobertura (Pytest / Coverage)
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Variables de Entorno y Credenciales
.env
.env.local
.env.*.local
*.env
!.env.example

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Sistema Operativo
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# Datos locales, Dumps y Backups de Base de Datos (MongoDB)
data/
mongo_data/
dumps/
backups/
*.dump
*.archive
*.bson
*.json.gz

# Residuos de desarrollo multi-rama (Node / Next.js de front-end)
node_modules/
.next/
out/

# Editores e IDEs
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
