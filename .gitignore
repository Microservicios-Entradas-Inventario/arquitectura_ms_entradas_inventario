# ==============================================================================
# .gitignore — Branch: database (TicketU - Entradas e Inventario)
# ==============================================================================

# Sistema Operativo
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# Variables de Entorno y Secretos
.env
.env.local
.env.*.local
*.env
!.env.example

# Datos locales, Dumps y Backups de Base de Datos (MongoDB)
data/
mongo_data/
dumps/
backups/
*.dump
*.archive
*.bson
*.json.gz

# Python (Scripts de seed, migración o automatización)
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.ipynb_checkpoints

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Residuos de desarrollo multi-rama (Node / Next.js de front-end)
node_modules/
.next/
dist/
out/
build/

# Editores e IDEs
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
