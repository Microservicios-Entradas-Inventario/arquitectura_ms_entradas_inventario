# ==============================================================================
# Microservicio de Entradas e Inventario (TicketU - TITEC 2026-2)
# Plantilla de variables de entorno (.env.example)
# ==============================================================================

PORT=3000

# --- Base de Datos Propia (MongoDB) ---
MONGO_URI=mongodb://mongodb:27017
MONGO_DB=ticketu_entradas_db

# --- Event Broker Compartido (RabbitMQ) ---
BROKER_URL=amqp://ticketu:ticketu_dev@ticketu-rabbitmq:5672/ticketu
EVENT_EXCHANGE=ticketu.events
QUEUE_NAME=entradas.pagos

# --- Autenticación (Auth) ---
AUTH_SERVICE_URL=http://auth-service:10000
INTERNAL_API_KEY=CAMBIAR_CLAVE_COMPARTIDA_SEGURA

# --- Servicios del Ecosistema vía API Gateway ---
PAGOS_SERVICE_URL=http://ticketu-api-gateway:8080
CATALOGO_SERVICE_URL=http://ticketu-api-gateway:8080
CHECKIN_SERVICE_URL=http://ticketu-api-gateway:8080
PANEL_SERVICE_URL=http://ticketu-api-gateway:8080
PROMOCIONES_SERVICE_URL=http://ticketu-api-gateway:8080

# --- Opcionales ---
PAGOS_STAFF_COOKIE=
ALLOW_SIMULATED_WEBHOOK=false
