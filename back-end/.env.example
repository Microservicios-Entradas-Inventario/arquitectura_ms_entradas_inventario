# ==============================================================================
# Microservicio de Entradas e Inventario (TicketU - TITEC 2026-2)
# Variables de entorno de ejemplo (.env.example)
# Copiar a .env para sobreescribir valores en desarrollo local o en Docker.
# ==============================================================================

# --- Servidor FastAPI / Uvicorn ---
PORT=3000

# --- Base de Datos Propia (MongoDB - Database per Service) ---
# En Docker: mongodb://mongodb:27017
# Fuera de Docker (local): mongodb://localhost:27017
MONGO_URI=mongodb://localhost:27017
MONGO_DB=ticketu_entradas_db

# --- Event Broker Compartido (RabbitMQ - Platform Team) ---
# En Docker: amqp://ticketu:ticketu_dev@ticketu-rabbitmq:5672/ticketu
# Fuera de Docker (local): amqp://ticketu:ticketu_dev@localhost:5672/ticketu
BROKER_URL=amqp://ticketu:ticketu_dev@localhost:5672/ticketu
EVENT_EXCHANGE=ticketu.events
QUEUE_NAME=entradas.pagos

# --- Integración con Autenticación (Contrato Auth v3.0 / Pagos v2.3) ---
# En cada petición protegida se valida la sesión con GET {AUTH_SERVICE_URL}/internal/validar-sesion
# reenviando el header Cookie (jwt=...) tal cual llegó del navegador y la cabecera x-api-key.
# En Docker: http://auth-service:10000 | Local: http://localhost:10000
AUTH_SERVICE_URL=http://localhost:10000
INTERNAL_API_KEY=CAMBIAR_CLAVE_COMPARTIDA_SEGURA

# --- Integración con Pasarela de Pagos (Contrato Pagos <-> Entradas v2.3) ---
# En Docker: http://pagos-service:3000 | Local: http://localhost:3004
PAGOS_SERVICE_URL=http://localhost:3004
# Cookie opcional de respaldo con rol staff para tareas automáticas en segundo plano (si aplica)
PAGOS_STAFF_COOKIE=

# --- Integración con otros Microservicios del Ecosistema TicketU ---
PANEL_SERVICE_URL=http://localhost:3001
CATALOGO_SERVICE_URL=http://localhost:4000
CHECKIN_SERVICE_URL=http://localhost:3001
