            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"staff1@ticketu.test\",\n  \"password\": \"TicketuQA2026!\",\n  \"admin\": true\n}"
            },
            "url": "{{gateway_url}}/api/auth/login"
          }
        },
        {
          "name": "5.5 [Éxito 200] Validar ticket recién emitido en Check-in (1er escaneo)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Primer escaneo autoriza ingreso (TICKET_FOUND)', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.valido).to.be.true;",
                  "    pm.expect(json.motivo).to.eql('TICKET_FOUND');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
