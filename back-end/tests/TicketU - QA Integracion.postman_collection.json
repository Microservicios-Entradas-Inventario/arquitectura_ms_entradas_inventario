              "raw": "{\n  \"id_evento\": \"{{id_evento_pagado}}\",\n  \"id_usuario\": \"usr-qa-test\",\n  \"cantidad_entradas\": 1,\n  \"codigo_promocion\": \"NOEXISTE999\"\n}"
            },
            "url": "{{gateway_url}}/api/promociones/evaluar"
