                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_entrada\": \"{{id_entrada_emitida}}\",\n  \"id_evento\": \"{{id_evento_gratuito}}\"\n}"
            },
            "url": "{{gateway_url}}/api/checkin/validaciones"
          }
