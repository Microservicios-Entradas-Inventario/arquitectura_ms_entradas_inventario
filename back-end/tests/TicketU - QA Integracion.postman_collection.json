                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => { pm.response.to.have.status(200); });\r\npm.test(\"Contrato estricto v2.1 para QR\", () => {\r\n    const payload = pm.response.json().qr_payload;\r\n    pm.expect(payload).to.have.property(\"id_evento\");\r\n    pm.expect(payload).to.have.property(\"id_entrada\");\r\n    pm.expect(pm.response.json().habilitado_checkin).to.be.true;\r\n});"
