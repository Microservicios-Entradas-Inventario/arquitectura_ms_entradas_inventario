{
  "info": {
    "_postman_id": "5b28009e-e3cf-411f-910d-04b6b1bde9ea",
    "name": "TicketU - QA Integración E2E (Entradas ↔ Auth ↔ Catálogo ↔ Promociones ↔ Pagos ↔ Check-in ↔ Panel)",
    "description": "Suite de Pruebas de Integración (CA2) de Entradas e Inventario contra las contrapartes reales a través del API Gateway (`http://localhost:8080`). Incluye caso exitoso y al menos un caso de error por integración, sin depender de webhooks simulados.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gateway_url", "value": "http://localhost:8080", "type": "string" },
    { "key": "stock_inicial_evt101", "value": "150", "type": "string" },
    { "key": "id_reserva_catalogo", "value": "", "type": "string" },
    { "key": "id_entrada_emitida", "value": "", "type": "string" },
    { "key": "id_evento_gratuito", "value": "evt-101", "type": "string" },
    { "key": "id_evento_pagado", "value": "evt-77889", "type": "string" }
  ],
  "item": [
    {
      "name": "01. Autenticación (Entradas ↔ Auth)",
      "item": [
        {
          "name": "1.1 [Error 401] Bloqueo de compra sin cookie JWT",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rechaza compra sin sesión con 401 NO_AUTENTICADO', function () {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(pm.response.text()).to.include('NO_AUTENTICADO');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_evento\": \"{{id_evento_pagado}}\",\n  \"tipo_entrada\": \"PAGADA\",\n  \"cantidad\": 1\n}"
            },
            "url": "{{gateway_url}}/api/entradas/procesar-compra"
          }
        },
        {
          "name": "1.2 [Error 401] Rechazo de cookie JWT alterada o inválida",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Auth rechaza JWT alterado y Entradas propaga 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(pm.response.text()).to.include('NO_AUTENTICADO');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Cookie", "value": "jwt=token.invalido.firmamala" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_evento\": \"{{id_evento_pagado}}\",\n  \"cantidad\": 1,\n  \"tiempo_limite_minutos\": 15\n}"
            },
            "url": "{{gateway_url}}/api/entradas/reservas/hold"
          }
        },
        {
          "name": "1.3 [Éxito 200] Login real de comprador en Auth (Cookie JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login real en Auth responde 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"comprador1@ticketu.test\",\n  \"password\": \"TicketuQA2026!\"\n}"
            },
            "url": "{{gateway_url}}/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "02. Integración Entradas ↔ Catálogo de Eventos",
      "item": [
        {
          "name": "2.1 [Éxito 200] Consultar disponibilidad inicial en Entradas (evt-101)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Disponibilidad inicial 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.idEvento).to.eql('evt-101');",
                  "    pm.collectionVariables.set('stock_inicial_evt101', String(json.stockDisponible));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{gateway_url}}/api/entradas/eventos/evt-101/disponibilidad"
          }
        },
        {
          "name": "2.2 [Éxito 200] Crear reserva Hold (-2 cupos) con sesión Auth y propagar a Catálogo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Hold creado 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.estado_reserva).to.eql('RESERVADO');",
                  "    pm.expect(json.cantidad_entrada).to.eql(2);",
                  "    pm.collectionVariables.set('id_reserva_catalogo', json.id_reserva);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_evento\": \"evt-101\",\n  \"cantidad\": 2,\n  \"tiempo_limite_minutos\": 15\n}"
            },
            "url": "{{gateway_url}}/api/entradas/reservas/hold"
          }
        },
        {
          "name": "2.3 [Éxito 200] Verificar stock actualizado (-2) en Catálogo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Stock en Catálogo bajó exactamente en 2 unidades', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    const esperado = Number(pm.collectionVariables.get('stock_inicial_evt101')) - 2;",
                  "    pm.expect(json.data.stock_actual).to.eql(esperado);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{gateway_url}}/api/catalogo/eventos/evt-101"
          }
        },
        {
          "name": "2.4 [Éxito 200] Cancelar reserva Hold y restaurar stock en Catálogo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Reserva cancelada y cupos liberados', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().cupos_liberados).to.eql(2);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"motivo\": \"Prueba QA de liberación de cupos\"\n}"
            },
            "url": "{{gateway_url}}/api/entradas/reservas/{{id_reserva_catalogo}}/cancelar"
          }
        },
        {
          "name": "2.5 [Error 400] Rechazo de stock negativo en Catálogo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Catálogo rechaza nuevo_stock negativo con 400', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nuevo_stock\": -5,\n  \"token_sesion\": \"entradas-service-sync\"\n}"
            },
            "url": "{{gateway_url}}/api/catalogo/eventos/evt-104/stock"
          }
        }
      ]
    },
    {
      "name": "03. Integración Entradas ↔ Promociones",
      "item": [
        {
          "name": "3.1 [Error/Sin descuento] Código promocional inexistente devuelve 0% sin alterar cobro",
