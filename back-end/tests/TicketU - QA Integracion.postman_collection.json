            },
            "url": "{{gateway_url}}/api/checkin/validaciones"
          }
        },
        {
          "name": "5.6 [Error negocio] Segundo escaneo rechazado por antifraude (TICKET_ALREADY_USED)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Segundo escaneo rechazado con TICKET_ALREADY_USED', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.valido).to.be.false;",
