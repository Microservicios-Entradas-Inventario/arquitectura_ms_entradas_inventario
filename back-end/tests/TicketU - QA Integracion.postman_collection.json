        {
          "name": "Historial de usuario y detalle inmutable (HU-02 y HU-04)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 y retorna un array\", () => {\r\n    pm.response.to.have.status(200);\r\n    pm.expect(pm.response.json()).to.be.an(\"array\");\r\n});\r\npm.test(\"Reglas de negocio HU-04 (Inmutabilidad)\", () => {\r\n    const data = pm.response.json();\r\n    if(data.length > 0) {\r\n        pm.expect(data[0].tipo_acceso).to.eql(\"GENERAL\");\r\n        pm.expect(data[0]).to.have.property(\"precio_final_pagado\");\r\n        pm.expect(data[0]).to.have.property(\"lugar_ingreso\");\r\n    }\r\n});"
                ]
              }
            }
          ],
