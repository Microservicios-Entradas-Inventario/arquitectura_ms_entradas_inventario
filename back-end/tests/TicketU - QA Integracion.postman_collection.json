          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cantidad_entradas\": 0\n}"
            },
            "url": "{{gateway_url}}/api/promociones/evaluar"
          }
        }
      ]
    },
    {
      "name": "04. Integración Entradas ↔ Pagos",
      "item": [
        {
          "name": "4.1 [Éxito 200] Procesar compra pagada real (Auth + Entradas + Pagos + Catálogo)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Procesar compra pagada responde 200 con id_reserva, id_pago y url_checkout', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('id_reserva');",
                  "    pm.expect(json).to.have.property('id_pago').that.is.a('string').and.is.not.empty;",
                  "    pm.expect(json.estado_pago).to.eql('PENDIENTE');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_evento\": \"{{id_evento_pagado}}\",\n  \"tipo_entrada\": \"PAGADA\",\n  \"cantidad\": 1,\n  \"metodo\": \"formulario\"\n}"
            },
            "url": "{{gateway_url}}/api/entradas/procesar-compra"
          }
        },
        {
          "name": "4.2 [Éxito 200] Consulta de reserva por Pagos (INT-01)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Contrato INT-01 retorna total, cantidad_entradas, estado y nombre_codigo', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.id_reserva).to.eql('res-demo-pagos');",
                  "    pm.expect(json).to.have.property('total', 20000);",
                  "    pm.expect(json).to.have.property('cantidad_entradas', 2);",
                  "    pm.expect(json).to.have.property('nombre_codigo');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{gateway_url}}/api/entradas/reservas/res-demo-pagos"
          }
        },
        {
          "name": "4.3 [Error 404] Consulta de reserva inexistente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Reserva inexistente retorna 404', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{gateway_url}}/api/entradas/reservas/res-inexistente-000"
          }
        },
        {
          "name": "4.4 [Error 403] Webhook simulado deshabilitado en workstation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Webhook simulado bloqueado con 403 Forbidden', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{gateway_url}}/api/entradas/reservas/res-demo-pagos/webhook-pago"
          }
        }
      ]
    },
    {
      "name": "05. Integración Entradas ↔ Check-in y Notificaciones",
      "item": [
        {
          "name": "5.1 [Éxito 200] Emitir entrada gratuita (registra en Check-in y publica entradas_emitidas en RabbitMQ)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Emisión gratuita 200 OK y registrada en Check-in', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.idEntrada).to.match(/^tk-/);",
                  "    pm.expect(json.registradoEnCheckin).to.be.true;",
                  "    pm.collectionVariables.set('id_entrada_emitida', json.idEntrada);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_evento\": \"{{id_evento_gratuito}}\",\n  \"cantidad_entradas\": 1,\n  \"precio_final\": 0\n}"
            },
            "url": "{{gateway_url}}/api/entradas/emision-directa"
          }
        },
        {
          "name": "5.2 [Éxito 200] Consultar entrada para Check-in y QR",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Retorna id_ticket, id_evento y estado_entrada EMITIDA', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.estado_entrada).to.eql('EMITIDA');",
                  "    pm.expect(json.id_evento).to.eql(pm.collectionVariables.get('id_evento_gratuito'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{gateway_url}}/api/entradas/{{id_entrada_emitida}}"
          }
