              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => { pm.response.to.have.status(200); });\r\npm.test(\"Guarda id_reserva en variable de entorno\", () => {\r\n    if(pm.response.code === 200){\r\n        pm.environment.set(\"id_reserva\", pm.response.json().id_reserva);\r\n    }\r\n});"
                ]
              }
            }
          ],
